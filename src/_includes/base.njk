<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.tagline }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.tagline }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{% if slug %}article{% else %}website{% endif %}">
<meta property="og:image" content="{{ site.url }}{% if slug %}/posts/{{ slug }}/cover.png{% else %}/cover.png{% endif %}">
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="me" href="https://www.instagram.com/joshuaedialeofficial"><meta name="theme-color" content="#000000">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="bar"><div class="in">
  <a class="mark" href="/" aria-label="Music Notes home"><svg viewBox="0 0 40 24" aria-hidden="true"><g stroke="currentColor" stroke-opacity=".5"><line x1="0" x2="40" y1="4" y2="4"/><line x1="0" x2="40" y1="9" y2="9"/><line x1="0" x2="40" y1="14" y2="14"/><line x1="0" x2="40" y1="19" y2="19"/></g><ellipse cx="13" cy="16.5" rx="4" ry="2.8" transform="rotate(-22 13 16.5)" fill="#FF8000"/><line x1="16.6" x2="16.6" y1="16" y2="2" stroke="#FF8000" stroke-width="1.6"/><ellipse cx="28" cy="11.5" rx="4" ry="2.8" transform="rotate(-22 28 11.5)" fill="currentColor"/></svg><span>Music Notes</span></a>
  <nav aria-label="Main"><a href="/">All posts</a><a href="{{ site.main }}">joshuaediale.com</a></nav>
</div></header>
<main id="main">
{{ content | safe }}
</main>
<footer class="foot"><div class="in">
  <p class="sig">Music Notes is written by Joshua Ediale, worship leader, singer and vocal coach.</p>
  <p class="soc">{% for x in site.socials %}<a href="{{ x.url }}" rel="me noopener" target="_blank">{{ x.name }}</a>{% endfor %}<a href="{{ site.whatsapp }}">WhatsApp</a></p>
  <p><a href="{{ site.main }}">Main site</a><a href="{{ site.about }}">About Joshua</a><a href="/feed.xml">RSS feed</a></p>
  <p class="small">© {{ "" | year }} Joshua Ediale</p>
</div></footer>
</body>
</html>
